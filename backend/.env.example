APP_ENV=local
APP_NAME=telegram-bitable-work-agent

# Local development database only.
# Do not use this database for tests that reset schemas.
DATABASE_URL=postgresql+psycopg://ads_agent:ads_agent@127.0.0.1:5432/ads_agent?connect_timeout=3

# Local development Redis. Stage 03 staging uses deploy/stage03/.env.stage03 on the server.
REDIS_URL=redis://localhost:6379/0

# Stage 03 safety defaults. Keep these disabled unless a later stage explicitly changes scope.
TELEGRAM_SEND_MODE=dry_run
LLM_ENABLED=false
PROVIDER_MODE=disabled
STAGE06_NOTIFICATION_MODE=disabled
STAGE06_NOTIFICATION_ALLOWED_CHAT_IDS=

# Stage 05 Agent workflow defaults. Local tests use fake mode.
# Real OpenRouter is required for Stage 06 backend-readiness smoke when configured.
AGENT_WORKFLOW_MODE=fake
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_SAVE_FULL_PROMPT=false
AGENT_SAVE_FULL_RESPONSE=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
# Stage06 real LLM smoke action: summarize or draft_update.
STAGE06_OPENROUTER_SMOKE_ACTION=summarize

# Do not commit real Telegram Bot Token, webhook secret, OpenRouter key, provider key,
# database password beyond local examples, or Redis password.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPENROUTER_API_KEY=

# Stage 06 backend-readiness smoke settings.
# Must be a disposable local PostgreSQL database; the smoke script resets public schema.
STAGE06_LOCAL_DATABASE_URL=postgresql+psycopg://ads_agent:ads_agent@127.0.0.1:5432/stage06_smoke?connect_timeout=3

# Optional real Telegram entry smoke. Use a test bot/chat/user only.
STAGE06_TELEGRAM_TEST_CHAT_ID=
STAGE06_TELEGRAM_TEST_USER_ID=
STAGE06_TELEGRAM_EMPLOYEE_ALIAS=ops
STAGE06_TELEGRAM_AUTO_DISCOVER=false

# Explicitly mutates Telegram webhook state for a temporary getUpdates smoke.
# Keep disabled unless a user confirms the temporary switch.
STAGE06_TELEGRAM_TEMPORARY_POLLING=false
STAGE06_TELEGRAM_DROP_PENDING_UPDATES=false
STAGE06_TELEGRAM_POLL_TIMEOUT_SECONDS=120
