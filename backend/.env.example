APP_ENV=local
APP_NAME=telegram-bitable-work-agent

# Local development database only.
# Do not use this database for tests that reset schemas.
DATABASE_URL=postgresql+psycopg://ads_agent:ads_agent@127.0.0.1:5432/ads_agent?connect_timeout=3

# Local development Redis. Stage 03 staging uses deploy/stage03/.env.stage03 on the server.
REDIS_URL=redis://localhost:6379/0

# Stage 03 safety defaults. Keep these disabled unless a later stage explicitly changes scope.
TELEGRAM_SEND_MODE=dry_run
LLM_ENABLED=false
PROVIDER_MODE=disabled

# Do not commit real Telegram Bot Token, webhook secret, OpenRouter key, provider key,
# database password beyond local examples, or Redis password.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
