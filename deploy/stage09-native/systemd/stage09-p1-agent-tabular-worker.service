[Unit]
Description=Stage09 P1 Stage10 tabular specialist worker

[Service]
Type=simple
User=stage09-p1
Group=stage09-p1
WorkingDirectory=/opt/stage09-p1/current/backend
EnvironmentFile=/etc/stage09-p1/runtime.env
ExecStartPre=/opt/stage09-p1/current/deploy/stage09-native/scripts/verify-native-isolation.sh /etc/stage09-p1/runtime.env
ExecStart=/opt/stage09-p1/current-venv/bin/python -m app.workers.agent_tabular_runtime
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
