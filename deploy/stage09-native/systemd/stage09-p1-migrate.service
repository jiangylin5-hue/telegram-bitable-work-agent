[Unit]
Description=Stage09 P1 controlled fixed-revision migration

[Service]
Type=oneshot
User=stage09-p1
Group=stage09-p1
WorkingDirectory=/opt/stage09-p1/current/backend
EnvironmentFile=/etc/stage09-p1/runtime.env
ExecStartPre=/opt/stage09-p1/current/deploy/stage09-native/scripts/verify-native-isolation.sh /etc/stage09-p1/runtime.env
ExecStart=/opt/stage09-p1/current-venv/bin/alembic upgrade 20260728_0034
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

# P1-B invokes this unit explicitly after offline SQL review; it has no [Install] section.
