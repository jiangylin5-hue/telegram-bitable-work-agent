server {
    listen 443 ssl http2;
    server_name {{STAGE09_P1_PUBLIC_HOSTNAME}};

    ssl_certificate {{STAGE09_P1_CERTIFICATE_PATH}};
    ssl_certificate_key {{STAGE09_P1_CERTIFICATE_KEY_PATH}};

    root /var/www/stage09-p1/current;
    index index.html;
    client_max_body_size 16m;

    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        try_files /index.html =404;
    }

    location ^~ /assets/ {
        try_files $uri =404;
    }

    location = /favicon.ico {
        try_files /favicon.ico =404;
    }

    location = /browser-handoff.html {
        try_files /browser-handoff.html =404;
        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
