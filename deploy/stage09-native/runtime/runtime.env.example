# Stage09 P1 runtime key-name contract. Copy only to /etc/stage09-p1/runtime.env
# on the authorized server. Do not commit the target file or replace placeholders
# with secrets in this repository. TELEGRAM_WEBHOOK_SECRET is required when
# APP_ENV=staging: set it to a random target-only nonce used solely for local
# webhook validation. It is not a Bot token, does not enable Telegram, and does
# not write to an external system.
APP_ENV=staging

POSTGRES_USER=stage09_p1
POSTGRES_PASSWORD=REPLACE_ON_TARGET
POSTGRES_DB=stage09_p1
DATABASE_URL=postgresql+psycopg://stage09_p1:REPLACE_ON_TARGET@127.0.0.1:5432/stage09_p1
REDIS_URL=unix:///run/stage09-p1/redis.sock?db=0

TELEGRAM_WEBHOOK_SECRET=REPLACE_ON_TARGET
TELEGRAM_SEND_MODE=dry_run
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_TEST_SEND_ALLOWED_CHAT_IDS=
STAGE06_NOTIFICATION_ALLOWED_CHAT_IDS=

LLM_ENABLED=false
AGENT_WORKFLOW_MODE=fake
PROVIDER_MODE=disabled
AGENT_SAVE_FULL_PROMPT=false
AGENT_SAVE_FULL_RESPONSE=false

STAGE09_P1_ARTIFACT_ID=stage09-p1-20260722-example
STAGE09_P1_RELEASE_DIR=/opt/stage09-p1/releases/stage09-p1-20260722-example
STAGE09_P1_NGINX_INTERNAL_PORT=18090
