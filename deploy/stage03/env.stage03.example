APP_ENV=staging
APP_NAME=telegram-bitable-work-agent

POSTGRES_USER=stage03_user
POSTGRES_PASSWORD=CHANGE_ME_STAGE03_POSTGRES_PASSWORD
POSTGRES_DB=stage03
DATABASE_URL=postgresql+psycopg://stage03_user:CHANGE_ME_STAGE03_POSTGRES_PASSWORD@postgres:5432/stage03

REDIS_URL=redis://redis:6379/0
STAGE03_REDIS_STREAM_NAME=stage03:events
STAGE03_REDIS_GROUP_NAME=telegram-message-workers
STAGE03_REDIS_CONSUMER_NAME=stage03-worker-1
STAGE03_WORKER_BATCH_SIZE=10
STAGE03_WORKER_POLL_INTERVAL_SECONDS=1
STAGE03_OUTBOX_BRIDGE_BATCH_SIZE=10
STAGE03_OUTBOX_BRIDGE_POLL_INTERVAL_SECONDS=1

TELEGRAM_BOT_TOKEN=CHANGE_ME_STORE_ONLY_ON_SERVER
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_GENERATE_OUTSIDE_GIT
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_SEND_MODE=dry_run

LLM_ENABLED=false
PROVIDER_MODE=disabled

STAGE03_DOMAIN=stage03.example.com
