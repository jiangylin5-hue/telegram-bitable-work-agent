FROM node:22-alpine AS build

WORKDIR /workspace/mini-app

COPY mini-app/package.json mini-app/package-lock.json ./
RUN npm ci

COPY mini-app/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/stage07-acceptance/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/mini-app/dist /usr/share/nginx/html

EXPOSE 80
