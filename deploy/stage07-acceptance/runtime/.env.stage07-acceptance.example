# This file is a key-name contract only. Copy it to ignored runtime/.env.stage07-acceptance on the server.
# Never commit a real value, Bot token, chat ID, secret, URL token or private key.

STAGE07_ENV_FILE=runtime/.env.stage07-acceptance
APP_ENV=staging
POSTGRES_USER=stage07_acceptance
POSTGRES_PASSWORD=replace-with-generated-isolated-secret
POSTGRES_DB=stage07_acceptance
DATABASE_URL=postgresql+psycopg://stage07_acceptance:replace-with-generated-isolated-secret@postgres:5432/stage07_acceptance
REDIS_URL=redis://redis:6379/0
STAGE07_CADDY_NETWORK=telegram-bitable-stage03_default
STAGE03_API_CONTAINER=telegram-bitable-stage03-api-1
STAGE07_API_IMAGE=stage07-acceptance-api:latest

OPENROUTER_API_KEY=runtime-only
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ENABLED=true
AGENT_WORKFLOW_MODE=real_openrouter
PROVIDER_MODE=disabled
AGENT_SAVE_FULL_PROMPT=false
AGENT_SAVE_FULL_RESPONSE=false

TELEGRAM_BOT_TOKEN=runtime-only
TELEGRAM_WEBHOOK_SECRET=runtime-only
TELEGRAM_SEND_MODE=restricted_test
TELEGRAM_TEST_SEND_ALLOWED_CHAT_IDS=one-private-test-chat-only
STAGE07_TELEGRAM_BOT_USERNAME=ExampleStage07Bot
