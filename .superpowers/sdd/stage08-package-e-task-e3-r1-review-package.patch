+class CollaborationBudget(BaseModel):
+    model_config = _STRICT_FROZEN_CONFIG
+
+    max_graph_depth: Literal[3] = 3
+    max_parallel_reads: Literal[3] = 3
+    max_retrieval_chunks: Literal[12] = 12
