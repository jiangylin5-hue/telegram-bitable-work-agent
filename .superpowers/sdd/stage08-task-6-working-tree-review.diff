+def _redacted_case_result(
+    case_id: str,
+    *,
+    status: str = "passed",
+    labels: tuple[str, ...] = (),
+) -> RedactedCaseResult:
+    return RedactedCaseResult(
+        case_id=case_id,
+        status=status,
+        failure_labels=labels,
+        evaluation_passed=status == "passed",
+        safety_checks_passed=status == "passed",
